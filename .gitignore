# Local environments and caches
.venv/
node_modules/
__pycache__/
.cache/
.DS_Store
Thumbs.db

# 勘察用的一次性脚本与 asar 展开目录（体积大、可重建）
.recon/

# 运行产物
*.log
tmp/
tests/.tmp/

# 真机测试的一次性运行时（可重建；.verify 下的脚本与配置要保留）
.verify/home/
.verify/proj/
.verify/demo-ws/
# 真实会话日志的测试夹具（由 .verify/fixture-real-sessions.mjs 复制而来）
# ⚠️ 里面是**用户真实对话内容**，绝不入库。
.verify/fixtures/
# 离线迁移工具的一次性产物
.verify/migrate-out/
.verify/migrate-target/

# 文件权限修复的记录与撤销脚本（本机一次性产物，2026-10-07）
.verify/acl-recovery/

# 隐私与提交（合并自「AI 协作与项目开发」库 02-隐私与发布/模板/gitignore.fragment）
# 注意：忽略规则只影响尚未跟踪的文件，已跟踪内容与旧历史不会因此清除。
.env
.env.*
!.env.example
!.env.sample
!.env.template
.privacy.local.json
privacy-report*.json
private-audit/
private-backup/
raw-sessions/
*.original.bundle
*.pem
*.key
id_rsa
id_ed25519
credentials.json
auth.json
settings.local.json
